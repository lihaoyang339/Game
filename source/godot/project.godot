; The Manor — Godot 4.7 port (third-person). Engine configuration.

config_version=5

[application]

config/name="The Manor"
config/description="The Hollow Signal — Wrenfield Manor survival horror (third-person)"
config/version="0.4.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/macos_native_icon="res://icon.icns"
boot_splash/bg_color=Color(0.02, 0.02, 0.025, 1)
boot_splash/show_image=false
run/max_fps=60
run/low_processor_mode=false

[autoload]

Settings="*res://scripts/autoload/Settings.gd"
Perf="*res://scripts/autoload/Perf.gd"
NoiseBus="*res://scripts/autoload/NoiseBus.gd"
Game="*res://scripts/autoload/Game.gd"

[audio]

driver/output_latency=15
general/3d_panning_strength=1.0

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/resizable=true
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true
window/stretch/mode="disabled"
mouse_cursor/tooltip_position_offset=Vector2(10, 10)

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=false
buffering/agile_event_flushing=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
3d/run_on_separate_thread=false
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/use_physical_light_units=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.01, 0.01, 0.012, 1)
occlusion_culling/use_occlusion_culling=true
occlusion_culling/bvh_build_quality=2
mesh_lod/lod_change/threshold_pixels=1.0
shading/overrides/force_lambert_over_burley=false
limits/cluster_builder/max_clustered_elements=512
reflections/sky_reflections/roughness_layers=7
shader_compiler/shader_cache/enabled=true
shader_compiler/shader_cache/compress=true

[shader_globals]

storm_flash={
"type": "float",
"value": 0.0
}

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
